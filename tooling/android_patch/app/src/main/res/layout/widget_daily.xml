<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_dark_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均成本" android:textColor="#FFFFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/widget_daily_cost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="¥0.00" android:textColor="#FFFFFFFF" android:textSize="30sp" />
    <TextView android:id="@+id/widget_daily_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 件服役中资产" android:textColor="#B8FFFFFF" android:textSize="12sp" />
</LinearLayout>
