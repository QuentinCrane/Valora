<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="快速记录" android:textColor="#141518" android:textSize="14sp" />
    <Button android:id="@+id/widget_quick_asset" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:text="+ 新增资产" android:textAllCaps="false" />
    <Button android:id="@+id/widget_quick_wish" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="+ 新增心愿" android:textAllCaps="false" />
</LinearLayout>
