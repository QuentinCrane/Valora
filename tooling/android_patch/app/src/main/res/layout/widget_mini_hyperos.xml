<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_hyperos_background">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#72747B" android:textSize="10sp" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_mini_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="¥0.00" android:textColor="#111216" android:textSize="21sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/widget_mini_daily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_mini_daily_empty" android:textColor="#696B72" android:textSize="10sp" android:maxLines="2" android:gravity="end|center_vertical" android:includeFontPadding="false" />
</LinearLayout>
