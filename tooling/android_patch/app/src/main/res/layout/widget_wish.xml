<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wish_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="15dp"
    android:background="@drawable/widget_lime_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_wish_label" android:textColor="#72747B" android:textSize="12sp" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_wish_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="0" android:textColor="#141518" android:textSize="34sp" android:maxLines="1" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_wish_meta" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="@string/widget_wish_meta_empty" android:textColor="#72747B" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
