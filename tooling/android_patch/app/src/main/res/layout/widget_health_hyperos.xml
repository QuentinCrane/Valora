<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_health_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_hyperos_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_health_label" android:textColor="#72747B" android:textSize="12sp" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_health_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_health_good" android:textColor="#141518" android:textSize="27sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_health_meta" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="7dp" android:text="@string/widget_health_empty_meta" android:textColor="#72747B" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
