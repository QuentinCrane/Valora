<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_health_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_blue_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="资产体检" android:textColor="#141518" android:textSize="14sp" />
    <TextView android:id="@+id/widget_health_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="良好" android:textColor="#141518" android:textSize="30sp" />
    <TextView android:id="@+id/widget_health_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 个钱包漏洞" android:textColor="#7A7B82" android:textSize="12sp" />
</LinearLayout>
