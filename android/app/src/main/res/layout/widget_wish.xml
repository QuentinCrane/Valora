<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wish_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_lime_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="心愿" android:textColor="#141518" android:textSize="14sp" />
    <TextView android:id="@+id/widget_wish_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="#141518" android:textSize="34sp" />
    <TextView android:id="@+id/widget_wish_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 份快照" android:textColor="#7A7B82" android:textSize="12sp" />
</LinearLayout>
