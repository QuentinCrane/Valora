<resources>
    <style name="LaunchTheme" parent="android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="NormalTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="colorPrimary">#7CC6F2</item>
        <item name="colorOnPrimary">#113056</item>
        <item name="colorPrimaryContainer">#D9F2FF</item>
        <item name="colorOnPrimaryContainer">#113056</item>
        <item name="colorSecondary">#48AEE9</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E8F7FE</item>
        <item name="colorOnSecondaryContainer">#113056</item>
        <item name="colorTertiary">#7CC6F2</item>
        <item name="colorOnTertiary">#113056</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#113056</item>
        <item name="colorSurfaceVariant">#EEF8FE</item>
        <item name="colorOnSurfaceVariant">#547080</item>
        <item name="colorOutline">#A7DDF7</item>
        <item name="android:colorAccent">#7CC6F2</item>
        <item name="colorAccent">#7CC6F2</item>
        <item name="colorControlActivated">#7CC6F2</item>
        <item name="colorControlHighlight">#337CC6F2</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.Valora.DatePicker</item>
        <item name="materialCalendarFullscreenTheme">@style/ThemeOverlay.Valora.DatePicker</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
        <item name="materialButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
    </style>

    <style name="ThemeOverlay.Valora.DatePicker" parent="@style/ThemeOverlay.Material3.MaterialCalendar">
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="colorPrimary">#7CC6F2</item>
        <item name="colorOnPrimary">#113056</item>
        <item name="colorPrimaryContainer">#D9F2FF</item>
        <item name="colorOnPrimaryContainer">#113056</item>
        <item name="colorSecondary">#48AEE9</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E8F7FE</item>
        <item name="colorOnSecondaryContainer">#113056</item>
        <item name="colorTertiary">#7CC6F2</item>
        <item name="colorOnTertiary">#113056</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#113056</item>
        <item name="colorSurfaceVariant">#EEF8FE</item>
        <item name="colorOnSurfaceVariant">#547080</item>
        <item name="colorOutline">#A7DDF7</item>
        <item name="android:colorAccent">#7CC6F2</item>
        <item name="colorAccent">#7CC6F2</item>
        <item name="colorControlActivated">#7CC6F2</item>
        <item name="colorControlHighlight">#337CC6F2</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
        <item name="materialButtonStyle">@style/Widget.Valora.DatePicker.Button</item>
        <item name="materialCalendarStyle">@style/Widget.Valora.MaterialCalendar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Valora.DatePicker.Dialog</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Valora.ExtraLarge</item>
    </style>

    <!-- Keep the native MaterialDatePicker layout. Only tune colors, to avoid day-cell baseline / offset issues. -->
    <style name="Widget.Valora.MaterialCalendar" parent="Widget.MaterialComponents.MaterialCalendar">
        <item name="dayStyle">@style/Widget.Valora.MaterialCalendar.Day</item>
        <item name="dayInvalidStyle">@style/Widget.Valora.MaterialCalendar.Day.Invalid</item>
        <item name="daySelectedStyle">@style/Widget.Valora.MaterialCalendar.Day.Selected</item>
        <item name="dayTodayStyle">@style/Widget.Valora.MaterialCalendar.Day.Today</item>
        <item name="yearStyle">@style/Widget.Valora.MaterialCalendar.Year</item>
        <item name="yearSelectedStyle">@style/Widget.Valora.MaterialCalendar.Year.Selected</item>
        <item name="yearTodayStyle">@style/Widget.Valora.MaterialCalendar.Year.Today</item>
        <item name="rangeFillColor">#447CC6F2</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Day" parent="Widget.MaterialComponents.MaterialCalendar.Day">
        <item name="itemTextColor">#113056</item>
        <item name="itemFillColor">#00FFFFFF</item>
        <item name="itemStrokeColor">#00FFFFFF</item>
        <item name="itemRippleColor">#337CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Day.Selected" parent="Widget.MaterialComponents.MaterialCalendar.Day.Selected">
        <item name="itemTextColor">#113056</item>
        <item name="itemFillColor">#7CC6F2</item>
        <item name="itemStrokeColor">#7CC6F2</item>
        <item name="itemRippleColor">#557CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Day.Today" parent="Widget.MaterialComponents.MaterialCalendar.Day.Today">
        <item name="itemTextColor">#113056</item>
        <item name="itemFillColor">#D9F2FF</item>
        <item name="itemStrokeColor">#7CC6F2</item>
        <item name="itemStrokeWidth">1dp</item>
        <item name="itemRippleColor">#337CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Day.Invalid" parent="Widget.MaterialComponents.MaterialCalendar.Day.Invalid">
        <item name="itemTextColor">#66547080</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Year" parent="Widget.MaterialComponents.MaterialCalendar.Year">
        <item name="itemTextColor">#113056</item>
        <item name="itemRippleColor">#337CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Year.Selected" parent="Widget.MaterialComponents.MaterialCalendar.Year.Selected">
        <item name="itemTextColor">#113056</item>
        <item name="itemFillColor">#7CC6F2</item>
        <item name="itemStrokeColor">#7CC6F2</item>
        <item name="itemRippleColor">#557CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.MaterialCalendar.Year.Today" parent="Widget.MaterialComponents.MaterialCalendar.Year.Today">
        <item name="itemTextColor">#113056</item>
        <item name="itemFillColor">#D9F2FF</item>
        <item name="itemStrokeColor">#7CC6F2</item>
        <item name="itemStrokeWidth">1dp</item>
        <item name="itemRippleColor">#337CC6F2</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.Valora.DateCell</item>
    </style>

    <style name="Widget.Valora.DatePicker.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="rippleColor">#337CC6F2</item>
        <item name="backgroundTint">#00FFFFFF</item>
    </style>

    <style name="ThemeOverlay.Valora.DatePicker.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#7CC6F2</item>
        <item name="colorOnPrimary">#113056</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#113056</item>
        <item name="colorSecondary">#7CC6F2</item>
        <item name="android:colorAccent">#7CC6F2</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Valora.Dialog</item>
    </style>

    <style name="ShapeAppearance.Valora.DateCell" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Valora.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Valora.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge" />
</resources>
